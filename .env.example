# ============================================================
# Fibery → QBO Invoice Integration — Environment Template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================


# ------------------------------------------------------------
# Fibery
# ------------------------------------------------------------
FIBERY_WORKSPACE_URL=https://your-workspace.fibery.io
FIBERY_API_TOKEN=                        # Fibery Settings → API → Personal Token


# ------------------------------------------------------------
# Make.com
# ------------------------------------------------------------
MAKE_API_KEY=                            # Make.com → Profile → API Access → Generate Token
MAKE_ORGANIZATION_ID=
MAKE_TEAM_ID=

# QBO Invoice Creation scenario
MAKE_SCENARIO_ID_QBO=
MAKE_WEBHOOK_URL_QBO=

# Make.com connection IDs (for reference / scripted updates)
MAKE_CONNECTION_ID_QBO=
MAKE_CONNECTION_ID_FIBERY=
MAKE_CONNECTION_ID_CLOCKIFY=


# ------------------------------------------------------------
# QuickBooks Online
# ------------------------------------------------------------
# Note: OAuth is managed by Make.com's native QBO connector.
# QBO_CLIENT_ID and QBO_CLIENT_SECRET are stored in Make.com only.

QBO_REALM_ID=                            # QBO Company ID (verify against Make.com connection UID)
QBO_ITEM_ID=                             # QBO Item/Service ID used for invoice line items
